# Variables de compilación de la app Flutter.
# Se pasan con --dart-define, NO se leen de un archivo .env en runtime.
#
# flutter run \
#   --dart-define=SUPABASE_URL=https://xxxx.supabase.co \
#   --dart-define=SUPABASE_ANON_KEY=...

SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=

# Android: crear android/secrets.properties (ignorado por git) con:
# MAPS_API_KEY=tu_clave_de_google_maps

# Solo scripts locales de prueba (Python). NUNCA en la app.
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
